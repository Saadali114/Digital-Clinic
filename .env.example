# ==============================================================================
# MediConnect Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or private credentials to version control.
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mediconnect_dev?schema=public"

# Authentication & Session Security
# Generate a secure 32+ byte secret: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"
PORT="3000"

# Future Integration Placeholders (Inactive in Phase 1)
# AI_PROVIDER_API_KEY="your-llm-provider-api-key"
# WEBRTC_SIGNALING_SERVER="ws://localhost:3001"
# EMAIL_SERVER_HOST="smtp.example.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_FROM="no-reply@mediconnect.local"
